# ==================== LLM 网关（必填） ====================
# 任何 OpenAI 兼容网关均可：DeepSeek / 通义 / 智谱 / 本地 vLLM ...
# 示例为 DeepSeek 官方端点，换成你的供应商与模型即可
OPENAI_API_KEY=sk-你的key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-chat

# ==================== PostgreSQL / Redis ====================
# 宿主机裸跑（CLI / langgraph dev / 本地 server）用下面的本地地址；
# Docker compose 部署时会被容器内地址自动覆盖，无需修改
POSTGRES_URL=postgresql://analyst:analyst@127.0.0.1:5432/analyst
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== LangSmith 观测（可选） ====================
# 不填也能跑，填了之后每次对话的完整 trace（含 RAG 每级 span）在
# https://smith.langchain.com 可查
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=analyst-agent

# ==================== 缓存 TTL（可选，均有默认值） ====================
# SQL_CACHE_TTL=3600
# RAG_CACHE_TTL=86400
# EMB_CACHE_TTL=604800
